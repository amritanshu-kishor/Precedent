# Root .gitignore for PRECEDENT repository

# Environment files (CRITICAL: Never commit secrets)
.env
.env.*
*.env
*.env.*
!.env.example
!*/.env.example

# Frontend Dependencies & Build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Python Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Databases
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/precedent.db

# Log files
*.log
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/frontend*.log
frontend/frontend*.err
backend/uvicorn*.log
backend/uvicorn*.err
backend/uvicorn*.out

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary extraction directory
prced_1_2/
